# Host process env overrides the repo-root .env. Copy the keys you need.
# FalkorDB is local Docker for now. A later VM is these three values only.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
DATABASE_URL=postgresql://frontier:frontier@localhost:5432/frontier?sslmode=disable
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=frontier-research-papers
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small
RATE_BACKEND=auto
RATE_CAPACITY_STUDENT=60
DAILY_TOKENS_STUDENT=200000
DAILY_USD_STUDENT=10
DAILY_USD_ORG=20
MONTHLY_USD=50
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
ADMIN_EMAILS=
CORPUS_GRAPH=frontier_corpus
MANIFEST_PATH=
MCP_ALLOWED_HOSTS=
